# TrustLedger Frontend Configuration Example
# Copy this file to .env or .env.local and configure your environment variables.

# Backend API Endpoint URL (Default local development)
VITE_API_URL=http://localhost:8000

# Supabase Authentication & Storage (Optional: Demo mode active if left unconfigured)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
