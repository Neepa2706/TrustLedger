# TrustLedger Project Environment Configuration Template
# Copy this file to .env in your respective directories with your actual local configuration.

# Backend Settings (see backend/.env.example)
PROJECT_NAME=TrustLedger
SERVICE_NAME=trustledger-api
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend Settings (see frontend/.env.example)
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
